# --- target language ---
TARGET_LANG=fa
TARGET_LANG_NAME=Persian (Farsi)

# --- provider: openai | ollama | anthropic ---
PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local option — nothing leaves the machine. Needs: ollama serve
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Terms that must stay in English
# Terms that must stay in English. Add your own product vocabulary here —
# whatever your team says out loud that a translator would otherwise mangle.
GLOSSARY=API,SDK,merge request,pipeline,repository,deploy
