{
  "manifest_version": 3,
  "name": "Meeting Caption Translator",
  "version": "1.0.0",
  "description": "Reads Microsoft Teams live captions and translates them via a local service.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://teams.cloud.microsoft/*",
    "https://*.cloud.microsoft/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "http://127.0.0.1:8100/*",
    "http://localhost:8100/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://teams.cloud.microsoft/*",
        "https://*.cloud.microsoft/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
